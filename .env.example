# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=univerreviews
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=univerreviews_production

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ROOT_USER=univerreviews
MINIO_ROOT_PASSWORD=change_me_minio_password

# ─── Rails ────────────────────────────────────────────────────────────────────
SECRET_KEY_BASE=generate_with_rails_secret

# ─── Next.js / Auth ───────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Active Record Encryption (token do UniverCampus) ────────────────────────
# Gere com: cd apps/api && bin/rails db:encryption:init
# Defina nos serviços api E sidekiq. Trocar depois torna os tokens salvos
# ilegíveis (o lojista precisa colar o token de novo).
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ─── UniverCampus ────────────────────────────────────────────────────────────
# URL pré-preenchida no admin (o lojista pode editar).
UNIVERCAMPUS_API_URL=https://univercampus.cloud

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@univerreviews.com

# ─── Billing ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── URLs ─────────────────────────────────────────────────────────────────────
API_URL=https://api.univerreviews.com
FRONTEND_URL=https://dash.univerreviews.com

# Public URL of the external payment platform's purchase page.
# Surfaced as the primary CTA inside the admin's paywall modal
# (`apps/admin/src/components/paywall/PaywallModal.tsx`). When unset, the
# CTA falls back to the in-app `/[workspace]/billing` page.
# NEXT_PUBLIC_ prefix is required so Next.js inlines the value at build
# time for the client bundle.
NEXT_PUBLIC_UPGRADE_URL=https://billing.univerreviews.com/upgrade
